<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.winniethepooh</groupId>
	<artifactId>HotelSystemBackend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>HotelSystemBackend</name>
	<description>HotelSystemBackend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<!-- 1.20.x 使用本地已有的 ryuk 0.8.1 镜像；Boot 3.3.4 默认管理的是 1.19.8 -->
		<testcontainers.version>1.20.3</testcontainers.version>
		<docker.api.version>1.44</docker.api.version>
		<skipApiTests>false</skipApiTests>
		<skipBrowserTests>false</skipBrowserTests>
		<!-- surefire / failsafe 默认读取 argLine：测试 JVM 时区与数据库一致（conventions.md 第 1 节） -->
		<argLine>-Duser.timezone=Asia/Shanghai</argLine>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>3.0.3</version>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter-test</artifactId>
			<version>3.0.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.2.0</version>
		</dependency>


		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.15</version>
		</dependency>
		<!--        这个依赖是md5加密密码需要的（现在只用于识别和迁移旧的 MD5 哈希）-->

		<!-- BCrypt 密码哈希；只引入 crypto 模块，不引入整套 Spring Security，版本由 Boot 管理 -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>


		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt</artifactId>
			<version>0.9.1</version>
		</dependency>
		<!--        这个依赖是生成jwt令牌需要的-->



		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<!--        这个依赖是处理Java9以上生成jwt令牌的时候报
                     java.lang.ClassNotFoundException: javax.xml.bind.DatatypeConverter的问题-->

		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
			<version>3.18.1</version>
		</dependency>
		<dependency>
			<groupId>javax.activation</groupId>
			<artifactId>activation</artifactId>
			<version>1.1.1</version>
		</dependency>
		<!-- no more than 2.3.3-->
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.3.3</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<!--        这是AOP的依赖-->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
			<version>2.13.0</version> <!-- 请根据你的项目选择合适的版本 -->
		</dependency>
		<!--        这是JSON处理LocalDateTime的依赖-->

		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-all</artifactId>
			<version>5.8.24</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>


	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- *IT 集成测试（Testcontainers，需要 Docker）在 integration-test 阶段由 failsafe 运行；
			     surefire 默认只认 *Test/*Tests，mvn test 不依赖 Docker -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<id>default</id>
						<configuration>
							<skipITs>${skipApiTests}</skipITs>
							<excludes><exclude>**/BrowserE2EIT.java</exclude></excludes>
						</configuration>
					</execution>
					<execution>
						<id>browser-e2e</id>
						<goals><goal>integration-test</goal><goal>verify</goal></goals>
						<configuration>
							<skipITs>${skipBrowserTests}</skipITs>
							<includes><include>**/BrowserE2EIT.java</include></includes>
							<reportsDirectory>${project.build.directory}/failsafe-e2e-reports</reportsDirectory>
							<summaryFile>${project.build.directory}/failsafe-e2e-reports/failsafe-summary.xml</summaryFile>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<systemPropertyVariables>
						<!-- Docker Engine 29 起最低 API 为 1.44，testcontainers 1.20 默认用 1.32 会被拒；
						     旧版 Docker（<25）可用 -Ddocker.api.version=1.32 覆盖 -->
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
